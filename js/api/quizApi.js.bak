import { API_CONFIG } from './apiConfig.js';
import { CONFIG } from '../config/config.js';

function buildUrl(amount, difficulty, category) {
    const params = new URLSearchParams({
        amount: String(amount),
        type: 'multiple',
        encode: 'url3986',
    });

    if (difficulty && difficulty !== 'any') params.set('difficulty', difficulty);

    if (category && category !== 'any') {
        const numericCategory = CONFIG.categories[category];
        params.set('category', String(numericCategory ?? category));
    }

    return `${API_CONFIG.baseUrl}?${params.toString()}`;
}

export function decodeHtml(text = '') {
    const textarea = document.createElement('textarea');
    textarea.innerHTML = String(text);
    return textarea.value;
}

export function normalizeQuestion(question) {
    const correctAnswer = decodeHtml(question.correct_answer || '').trim();
    const rawOptions = [
        correctAnswer,
        ...(Array.isArray(question.incorrect_answers)
            ? question.incorrect_answers.map(decodeHtml)
            : []),
    ];

    const options = [...new Set(rawOptions.map(value => String(value).trim()))];

    for (let i = options.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [options[i], options[j]] = [options[j], options[i]];
    }

    return {
        id: globalThis.crypto?.randomUUID?.() || `api-${Date.now()}-${Math.random()}`,
        question: decodeHtml(question.question || ''),
        options,
        correctAnswer,
        category: decodeHtml(question.category || ''),
        difficulty: question.difficulty || 'medium',
        type: question.type || 'multiple',
    };
}

async function fetchWithTimeout(url) {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), API_CONFIG.timeout);
    try {
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return await response.json();
    } finally {
        clearTimeout(timeoutId);
    }
}

export async function fetchQuestions(amount = 10, difficulty = 'medium', category = 'any') {
    const url = buildUrl(amount, difficulty, category);
    let lastError = null;

    for (let attempt = 0; attempt <= (API_CONFIG.retries ?? 1); attempt += 1) {
        try {
            const data = await fetchWithTimeout(url);
            if (data.response_code !== API_CONFIG.responseCodes.SUCCESS) {
                throw new Error(`OpenTDB response code: ${data.response_code}`);
            }
            if (!Array.isArray(data.results) || !data.results.length) {
                throw new Error('No questions returned by API.');
            }
            return data.results.map(normalizeQuestion);
        } catch (error) {
            lastError = error;
            if (attempt < (API_CONFIG.retries ?? 1)) {
                await new Promise(resolve => setTimeout(resolve, 500));
            }
        }
    }

    throw lastError || new Error('Failed to fetch questions.');
}
